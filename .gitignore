# Secrets: never commit. Commit the .env.example files instead.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
dist-ssr/

# Uploaded audio (keep the folder, not the files)
server/uploads/*
!server/uploads/.gitkeep

# Audio files anywhere else (stray copies, exports). The small Playwright test tone is kept.
*.mp3
*.flac
*.wav
!client/pw_tests/fixtures/*.mp3

# Archives and logs
*.zip
*.log
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local
