PORT=4000
NODE_ENV=development
# Public address of the web app, including /app. Used in every emailed link.
# Must be your real address in production (the server refuses to start with localhost).
APP_URL=http://localhost:5173/app
# Shown in emails and notices (default: Track Record)
# PLATFORM_NAME=Track Record

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_rights
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_rights_test
# SSL is on in production and off otherwise. Set true or false to override.
# DATABASE_SSL=false
# DB_POOL_MAX=10

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-value>
EMAIL_HASH_KEY=<generate-a-long-random-value>

AUTH_RATE_LIMIT=1000
NOTICE_RATE_LIMIT=1000

ACCOUNT_RATE_LIMIT=1000
API_RATE_LIMIT=10000

# TRUST_PROXY=1

NOTICE_EXPIRY_DAYS=14
# NOTICE_RETENTION_TEXT=while this song is on the platform
# RWANDA_GUIDE_URL=
# LEARN_URL=

# console: prints emails in the server log (development only).
# smtp: sends for real (needs the nodemailer package). Production must not use console.
MAIL_TRANSPORT=console
MAIL_FROM="Track Record <no-reply@yourdomain.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
DEV_OUTBOX=true
