DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_rights
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_rights_test
JWT_SECRET=semicolondashclosingparenthesis
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173

EMAIL_HASH_KEY=<generated>
NOTICE_EXPIRY_DAYS=14
DEV_OUTBOX=true
AUTH_RATE_LIMIT=1000
NOTICE_RATE_LIMIT=1000
RESET_RATE_LIMIT=10

MAIL_TRANSPORT=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TrackRecord <no-reply@yourdomain.com>"

# --- Upload limits (all optional; defaults shown) ---
# Audio files are written to disk at UPLOAD_DIR. Cover art and avatars are stored in Postgres.
# On a host with a temporary disk (many free tiers) point UPLOAD_DIR at a persistent volume, or audio will vanish on redeploy.
# UPLOAD_DIR=./uploads
#
# Hosts that wipe the disk on restart (free tiers): keep audio in an S3-compatible bucket instead.
# Works with Cloudflare R2, Backblaze B2, Tigris and AWS S3. Create a bucket (keep it private) and an access key.
# STORAGE_DRIVER=s3
# S3_BUCKET=track-record-audio
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MAX_AUDIO_BYTES=104857600
# MAX_COVER_BYTES=26214400
# MAX_USER_BYTES=1073741824
# Keep this below the free space on the upload disk AND the free space in your Postgres plan (covers count towards both).
# MAX_PLATFORM_BYTES=10737418240
# Pilot caps. Set PILOT_LIMITS=off to remove all of them.
# Releases and songs are unlimited by default (0). Set a number only if you want a cap.
# MAX_RELEASES_PER_USER=0
# MAX_TRACKS_PER_RELEASE=0

# --- Hosting behind a proxy (Render etc.) ---
# TRUST_PROXY=1

# --- Email over HTTPS (use this on hosts that block SMTP: Render free, Railway Hobby) ---
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=
# MAIL_FROM="Track Record <your-verified-sender@example.com>"

# --- One-host deploy: the server also serves the website ---
# SERVE_CLIENT=true
